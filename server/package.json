{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:bruno": "cd bruno && pnpm dlx @usebruno/cli@4.2.0 run . -r --env Local",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
