# Copy to .env and fill in. Never commit .env.
PORT=3000
CLIENT_ORIGIN=http://localhost:5180

# MongoDB Atlas connection string (database name required in the path)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/familyframe?retryWrites=true&w=majority"

# Cloudinary (J1)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
