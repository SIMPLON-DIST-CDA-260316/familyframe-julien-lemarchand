meta {
  name: Nominal - suppression d'une photo
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/photos/{{createdPhotoId}}
  body: none
  auth: none
}

assert {
  res.status: eq 204
}

script:pre-request {
  // Without it the request hits /api/photos/ and fails with a misleading status.
  if (!bru.getVar('createdPhotoId')) {
    throw new Error('createdPhotoId absent : lancer le dossier photos en entier, create/01 doit passer')
  }
}

script:post-response {
  const axios = require('axios')
  test('la photo ne figure plus dans la liste', async () => {
    // A script request does not get the collection headers: send the session cookie itself.
    const list = await axios.get(`${bru.getEnvVar('baseUrl')}/api/photos`, {
      headers: { Cookie: bru.getVar('sessionCookie') },
    })
    const ids = list.data.photos.map(({ id }) => id)
    expect(ids).to.not.include(bru.getVar('createdPhotoId'))
  })
  test('la copie reçue par l\'admin reste', async () => {
    const list = await axios.get(`${bru.getEnvVar('baseUrl')}/api/photos`, {
      headers: { Cookie: bru.getVar('adminCookie') },
    })
    expect(list.data.photos.map(({ id }) => id)).to.include(bru.getVar('sharedPhotoId'))
  })
}

docs {
  NOMINAL → 204, puis `GET /api/photos` ne renvoie plus la photo. La copie
  que l'admin a reçue dans `share/02` (`sharedPhotoId`) reste dans sa
  bibliothèque, et l'image Cloudinary aussi : la copie y renvoie encore.
}
