meta {
  name: Nominal - envoi d'une photo JPEG
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/photos
  body: multipartForm
  auth: none
}

body:multipart-form {
  nickname: {{nickname}}
  photo: @file(fixtures/photo.jpg) @contentType(image/jpeg)
}

assert {
  res.status: eq 201
  res.body.nickname: eq {{nickname}}
  res.body.url: contains res.cloudinary.com
  res.body.id: isString
  res.body.publicId: isUndefined
}

docs {
  NOMINAL → 201 avec la photo créée. `publicId` n'est pas exposé.
}
