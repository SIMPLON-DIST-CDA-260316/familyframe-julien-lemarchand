meta {
  name: Nominal - envoi d'une photo JPEG
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/photos
  body: multipartForm
  auth: none
}

body:multipart-form {
  photo: @file(fixtures/photo.jpg) @contentType(image/jpeg)
}

assert {
  res.status: eq 201
  res.body.uploaderName: isUndefined
  res.body.url: contains res.cloudinary.com
  res.body.id: isString
  res.body.cloudinaryId: isUndefined
  res.body.senderName: isNull
  res.body.width: isNumber
  res.body.height: isNumber
  res.body.bytes: isNumber
}

script:post-response {
  const axios = require('axios')
  const { url, mediumUrl, thumbnailUrl } = res.body
  // photos/delete deletes this photo: the JPEG one does not pile up run after run.
  bru.setVar('createdPhotoId', res.body.id)
  test('format et compression choisis par Cloudinary', () => {
    expect(url).to.contain('f_auto,q_auto')
    expect(thumbnailUrl).to.contain('f_auto,q_auto')
  })
  test('photo entière limitée à 1920 px pour les écrans, jamais agrandie', () => {
    expect(url).to.contain('c_limit,h_1920,w_1920')
  })
  test('photo moyenne limitée à 1280 px pour les téléphones', () => {
    expect(mediumUrl).to.contain('c_limit,h_1280,w_1280')
    expect(mediumUrl).to.contain('f_auto,q_auto')
  })
  test('miniature carrée de 640 px, recadrée sur le sujet', () => {
    expect(thumbnailUrl).to.contain('c_fill,g_auto,h_640,w_640')
  })
  test('les trois URL livrent une image, en WebP pour un navigateur qui l\'accepte', async () => {
    for (const imageUrl of [url, mediumUrl, thumbnailUrl]) {
      const image = await axios.get(imageUrl, { headers: { Accept: 'image/webp,*/*' } })
      expect(image.status).to.equal(200)
      expect(image.headers['content-type']).to.match(/^image\//)
    }
  })
  test('URL signées : une transformation modifiée est refusée', async () => {
    expect(url).to.match(/\/s--[\w-]+--\//)
    expect(thumbnailUrl).to.match(/\/s--[\w-]+--\//)
    expect(mediumUrl).to.match(/\/s--[\w-]+--\//)
    // Bruno's axios throws on 4xx even with validateStatus: read the status from the error.
    for (const tampered of [thumbnailUrl.replace('w_640', 'w_641'), url.replace('w_1920', 'w_4096')]) {
      const status = await axios.get(tampered).then(
        (image) => image.status,
        (error) => error.response?.status,
      )
      expect(status).to.equal(401)
    }
  })
}

docs {
  NOMINAL → 201 avec la photo créée, dans la bibliothèque du compte connecté :
  la réponse ne porte plus de nom d'expéditeur (`uploaderName`) ; `senderName`
  vaut `null`, car le membre a envoyé la photo lui-même.
  `width`, `height` (en pixels) et `bytes` (poids en octets) décrivent l'image
  stockée, mesurée par Cloudinary à l'envoi : les infos de la photo les montrent.
  `cloudinaryId` n'est pas exposé : le serveur envoie des URL prêtes, `url`
  (photo entière, limitée à 1920 px par `c_limit` : l'image stockée va
  jusqu'à 4096 px pour l'impression), `mediumUrl` (limitée à 1280 px, que la
  visionneuse d'un téléphone choisit par `srcset`) et `thumbnailUrl`
  (miniature), toutes en `f_auto,q_auto`. Le test télécharge les trois URL : une transformation
  refusée par Cloudinary ferait échouer le test.

  Les URL sont signées (`s--…--`). Les tests des URL modifiées (miniature
  agrandie, photo entière demandée à 4096 px) supposent
  « Strict transformations » activé dans la console Cloudinary (Settings →
  Security) : sans ce réglage, Cloudinary accepte n'importe quelle
  transformation et le test échoue.

  Limite connue : « Strict transformations » bloque les transformations
  modifiées, pas l'original sans transformation. Une URL livrée dont on
  retire la transformation donne l'image stockée en 4096 px : même public,
  même photo. Ce cas n'est pas testé ici.
}
