meta {
  name: Edge - pseudo de plus de 30 caractères
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/photos
  body: multipartForm
  auth: none
}

body:multipart-form {
  uploaderName: abcdefghijklmnopqrstuvwxyz01234
  photo: @file(fixtures/photo.jpg) @contentType(image/jpeg)
}

assert {
  res.status: eq 400
  res.body.error: eq UPLOADER_NAME_INVALID
}

docs {
  EDGE → 400 UPLOADER_NAME_INVALID, 31 caractères pour 30 max.
}
