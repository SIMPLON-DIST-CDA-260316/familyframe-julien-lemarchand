meta {
  name: Nominal - envoi d'une image PNG
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/photos
  body: multipartForm
  auth: none
}

body:multipart-form {
  photo: @file(fixtures/photo.png) @contentType(image/png)
}

assert {
  res.status: eq 201
  res.body.url: isString
}

docs {
  NOMINAL → 201, le PNG est accepté. Le réencodage en JPEG n'est pas visible
  ici : l'URL finit toujours par `.jpg`, c'est le format de repli de
  `f_auto`. `photos.service.test.ts` vérifie que le PNG passe par `toFrameJpeg`.
}
