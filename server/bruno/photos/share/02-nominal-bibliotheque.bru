meta {
  name: Nominal - envoi d'une photo de la bibliothèque
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/photos/{{createdPhotoId}}/share
  body: json
  auth: none
}

body:json {
  {
    "friendIds": ["{{adminId}}", "{{memberId}}"],
    "message": "  Joyeux anniversaire !  "
  }
}

script:pre-request {
  const axios = require('axios')
  if (!bru.getVar('adminId')) {
    throw new Error('adminId absent : lancer tout le dossier photos/share, 01 doit passer')
  }
  const baseUrl = bru.getEnvVar('baseUrl')
  // The member asks, the admin accepts: they are friends for the rest of the folder.
  const { data } = await axios.post(
    `${baseUrl}/api/friendships`,
    { email: bru.getEnvVar('adminEmail') },
    { headers: { Cookie: bru.getVar('sessionCookie') } },
  )
  const friendshipId = data.friendship.id
  await axios.post(`${baseUrl}/api/friendships/${friendshipId}/accept`, null, {
    headers: { Cookie: bru.getVar('adminCookie') },
  })
  bru.setVar('shareFriendshipId', friendshipId)
}

assert {
  res.status: eq 201
  res.body.send.id: isString
  res.body.send.message: eq Joyeux anniversaire !
  res.body.send.recipients: length 1
  res.body.send.recipients[0].id: eq {{adminId}}
}

script:post-response {
  const axios = require('axios')
  // path is /api/photos (the library) or /api/photos/unopened (the photos waiting).
  const photosOf = async (cookie, path) => {
    const list = await axios.get(`${bru.getEnvVar('baseUrl')}${path}`, {
      headers: { Cookie: cookie },
    })
    return list.data.photos
  }
  // The newest photo the member sent to the admin: the list is newest first.
  const received = (await photosOf(bru.getVar('adminCookie'), '/api/photos/unopened')).find(
    ({ senderName }) => senderName === bru.getEnvVar('memberDisplayName'),
  )
  if (res.body.send?.id && received) {
    bru.setVar('librarySendId', res.body.send.id)
    bru.setVar('sharedPhotoId', received.id)
  }
  test('une issue par ami : l\'admin l\'a reçue, pas le membre lui-même', () => {
    const statusOf = (friendId) =>
      res.body.outcomes.find((outcome) => outcome.friendId === friendId)?.status
    expect(statusOf(bru.getVar('adminId'))).to.equal('sent')
    expect(statusOf(bru.getVar('memberId'))).to.equal('not_friends')
  })
  test('la photo reçue attend l\'admin, non ouverte, avec le message', () => {
    expect(received?.message).to.equal('Joyeux anniversaire !')
  })
  test('elle garde la taille et le poids de la photo du membre', async () => {
    const original = (await photosOf(bru.getVar('sessionCookie'), '/api/photos')).find(
      ({ id }) => id === bru.getVar('createdPhotoId'),
    )
    expect(original?.width).to.be.a('number')
    expect(received?.width).to.equal(original.width)
    expect(received?.height).to.equal(original.height)
    expect(received?.bytes).to.equal(original.bytes)
  })
  test('elle n\'est pas encore dans la bibliothèque de l\'admin', async () => {
    const ids = (await photosOf(bru.getVar('adminCookie'), '/api/photos')).map(({ id }) => id)
    expect(ids).to.not.include(received?.id)
  })
  test('la bibliothèque du membre ne change pas', async () => {
    const ids = (await photosOf(bru.getVar('sessionCookie'), '/api/photos')).map(({ id }) => id)
    expect(ids).to.not.include(received?.id)
    expect(ids).to.include(bru.getVar('createdPhotoId'))
  })
}

docs {
  NOMINAL → 201 avec l'envoi enregistré (`send`) et une issue par ami. Le
  script de départ rend le membre et l'admin amis (demande puis
  acceptation, id dans `shareFriendshipId`). La photo part à l'admin et au
  membre lui-même, en une requête : l'admin la reçoit (`sent`), le membre
  non (`not_friends`), et l'envoi ne nomme que l'admin. Le message est
  gardé sans les espaces autour (« Joyeux anniversaire ! »). L'id de
  l'envoi va dans `librarySendId` (repris par `sends/`), celui de la photo
  reçue, lue dans `GET /api/photos/unopened` de l'admin, dans
  `sharedPhotoId`. Elle pointe vers la même image Cloudinary que celle du
  membre ; le script vérifie qu'elle porte le message et la taille et le
  poids de l'original (`width`, `height`, `bytes`), qu'elle n'est pas
  encore dans la bibliothèque de l'admin, et que celle du membre ne gagne
  pas de photo.
}
