meta {
  name: Edge - photo d'un autre compte
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/photos/{{createdPhotoId}}/share
  body: json
  auth: none
}

body:json {
  {
    "friendIds": ["{{memberId}}"]
  }
}

script:pre-request {
  // The photo is the member's: the admin, their friend, tries to send it back to them.
  req.setHeader('Cookie', bru.getVar('adminCookie'))
}

assert {
  res.status: eq 404
  res.body.error: eq PHOTO_NOT_FOUND
}

docs {
  EDGE → 404 PHOTO_NOT_FOUND : l'admin, ami du membre, tente d'envoyer au
  membre la photo du membre. On n'envoie que ses propres photos ; la
  réponse est celle d'une photo inconnue (pas de 403, qui dirait qu'elle
  existe).
}
