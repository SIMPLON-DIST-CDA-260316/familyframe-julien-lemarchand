meta {
  name: Edge - envoi à soi-même
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/photos/{{createdPhotoId}}/share
  body: json
  auth: none
}

body:json {
  {
    "friendIds": ["{{memberId}}"]
  }
}

assert {
  res.status: eq 200
  res.body.send: isNull
  res.body.outcomes[0].status: eq not_friends
}

docs {
  EDGE → 200, `send` à `null` et l'issue `not_friends` : le membre s'envoie
  sa propre photo. On n'est pas
  son propre ami : même réponse qu'un compte inconnu ou une demande en
  attente.
}
