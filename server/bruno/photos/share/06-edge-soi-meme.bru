meta {
  name: Edge - envoi à soi-même
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/photos/{{createdPhotoId}}/share
  body: json
  auth: none
}

body:json {
  {
    "friendId": "{{memberId}}"
  }
}

assert {
  res.status: eq 403
  res.body.error: eq NOT_FRIENDS
}

docs {
  EDGE → 403 NOT_FRIENDS : le membre s'envoie sa propre photo. On n'est pas
  son propre ami : même réponse qu'un compte inconnu ou une demande en
  attente.
}
