meta {
  name: Edge - sans cookie de session
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/collections/{{collectionId}}/photos
  body: json
  auth: none
}

body:json {
  {
    "photoIds": ["{{batchPhotoId}}"]
  }
}

script:pre-request {
  // collection.bru sends the session cookie to every request: remove it here.
  req.deleteHeader('Cookie')
}

assert {
  res.status: eq 401
  res.body.error: eq UNAUTHENTICATED
}

docs {
  EDGE → 401 UNAUTHENTICATED : ajouter des photos demande une session.
}
