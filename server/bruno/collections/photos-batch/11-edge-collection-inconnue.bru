meta {
  name: Edge - collection inconnue
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/collections/000000000000000000000000/photos
  body: json
  auth: none
}

body:json {
  {
    "photoIds": ["{{batchPhotoId}}"]
  }
}

script:pre-request {
  if (!bru.getVar('collectionId') || !bru.getVar('batchPhotoId')) {
    throw new Error('collectionId ou batchPhotoId absent : lancer toute la collection, collections/create/01 et photos-batch/01 doivent passer')
  }
  // The throwaway account of invitations/accept/05, never the member (see collections/folder.bru).
  req.setHeader('Cookie', bru.getVar('inviteeCookie'))
}

assert {
  res.status: eq 404
  res.body.error: eq COLLECTION_NOT_FOUND
}

docs {
  EDGE → 404 COLLECTION_NOT_FOUND : la photo est bien celle du compte,
  mais aucune collection n'a cet id.
}
