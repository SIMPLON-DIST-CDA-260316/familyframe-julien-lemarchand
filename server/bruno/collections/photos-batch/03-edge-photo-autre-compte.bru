meta {
  name: Edge - une photo d'un autre compte dans la liste
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/collections/{{collectionId}}/photos
  body: json
  auth: none
}

body:json {
  {
    "photoIds": ["{{batchPhotoId}}", "{{batchMemberPhotoId}}"]
  }
}

script:pre-request {
  const axios = require('axios')
  if (!bru.getVar('collectionId') || !bru.getVar('batchPhotoId')) {
    throw new Error('collectionId ou batchPhotoId absent : lancer toute la collection, collections/create/01 et photos-batch/01 doivent passer')
  }
  // A photo of the member's library (default cookie), from the shared dev database.
  const { data } = await axios.get(`${bru.getEnvVar('baseUrl')}/api/photos`, {
    headers: { Cookie: bru.getVar('sessionCookie') },
  })
  if (data.photos.length === 0) {
    throw new Error("le membre n'a aucune photo : la base de dev doit être remplie (seed)")
  }
  bru.setVar('batchMemberPhotoId', data.photos[0].id)
  // The throwaway account of invitations/accept/05, never the member (see collections/folder.bru).
  req.setHeader('Cookie', bru.getVar('inviteeCookie'))
}

assert {
  res.status: eq 404
  res.body.error: eq PHOTO_NOT_FOUND
}

script:post-response {
  const axios = require('axios')
  // Read before test(): Bruno does not wait for an async test, the next request could run first.
  const list = await axios.get(`${bru.getEnvVar('baseUrl')}/api/collections`, {
    headers: { Cookie: bru.getVar('inviteeCookie') },
  })
  const collection = list.data.collections.find(({ id }) => id === bru.getVar('collectionId'))
  test("la collection n'a pas changé, même pour la photo du compte", () => {
    expect(collection.photoIds).to.eql([])
  })
}

docs {
  EDGE → 404 PHOTO_NOT_FOUND : le compte jetable envoie sa photo avec une
  photo du membre. Elle n'est pas la sienne : toute la liste est refusée,
  il n'apprend rien, et le script vérifie que la collection est restée vide.
}
