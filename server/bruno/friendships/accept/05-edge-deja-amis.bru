meta {
  name: Edge - nouvelle demande entre amis
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/friendships
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}"
  }
}

assert {
  res.status: eq 409
  res.body.error: eq ALREADY_FRIENDS
}

docs {
  EDGE → 409 ALREADY_FRIENDS : le membre redemande l'admin, qui est déjà
  son ami (`POST /api/friendships`, rangé ici parce qu'il suit
  l'acceptation).
}
