meta {
  name: Edge - demande dans l'autre sens
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/friendships
  body: json
  auth: none
}

body:json {
  {
    "email": "{{memberEmail}}"
  }
}

script:pre-request {
  if (!bru.getVar('adminCookie')) {
    throw new Error('adminCookie absent : lancer toute la collection, auth/login/05 doit passer')
  }
  req.setHeader('Cookie', bru.getVar('adminCookie'))
}

assert {
  res.status: eq 409
  res.body.error: eq FRIEND_REQUEST_EXISTS
}

docs {
  EDGE → 409 FRIEND_REQUEST_EXISTS : l'admin demande le membre alors que la
  demande du membre l'attend. Pas d'acceptation automatique : la page de
  l'admin lui propose « Accepter » juste en dessous.
}
