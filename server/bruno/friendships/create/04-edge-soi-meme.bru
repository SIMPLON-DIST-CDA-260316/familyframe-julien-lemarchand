meta {
  name: Edge - demande à soi-même
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/friendships
  body: json
  auth: none
}

body:json {
  {
    "email": "{{memberEmail}}"
  }
}

assert {
  res.status: eq 400
  res.body.error: eq SELF_FRIEND
}

docs {
  EDGE → 400 SELF_FRIEND : le membre tape sa propre adresse.
}
