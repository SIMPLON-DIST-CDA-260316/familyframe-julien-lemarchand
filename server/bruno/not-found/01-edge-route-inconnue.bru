meta {
  name: Edge - route inconnue
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/inconnue
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body.error: eq ROUTE_NOT_FOUND
}

docs {
  EDGE → 404 ROUTE_NOT_FOUND, au format JSON des erreurs (et non la page HTML par défaut d'Express).
}
