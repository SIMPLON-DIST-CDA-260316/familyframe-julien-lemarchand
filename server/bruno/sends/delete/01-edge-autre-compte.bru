meta {
  name: Edge - l'envoi d'un autre compte
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/api/sends/{{librarySendId}}
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar('deviceSendId')) {
    throw new Error('deviceSendId absent : lancer toute la collection, photos/share/08 doit passer')
  }
  req.setHeader('Cookie', bru.getVar('adminCookie'))
}

assert {
  res.status: eq 404
  res.body.error: eq SEND_NOT_FOUND
}

script:post-response {
  const axios = require('axios')
  const historyIds = async () => {
    const list = await axios.get(`${bru.getEnvVar('baseUrl')}/api/sends`, {
      headers: { Cookie: bru.getVar('sessionCookie') },
    })
    return list.data.sends.map(({ id }) => id)
  }
  test('l\'envoi est toujours dans l\'historique du membre', async () => {
    expect(await historyIds()).to.include(bru.getVar('librarySendId'))
  })
}

docs {
  EDGE → 404 SEND_NOT_FOUND : l'admin, qui a reçu la photo, ne peut pas
  retirer l'envoi du membre ; il reste.
}
