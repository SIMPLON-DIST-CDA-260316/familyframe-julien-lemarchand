meta {
  name: Nominal - retirer les envois des autres dossiers
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/sends/{{collectionSendId}}
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar('collectionSendId') || !bru.getVar('radioSendId')) {
    throw new Error('collectionSendId ou radioSendId absent : lancer toute la collection')
  }
}

assert {
  res.status: eq 204
}

script:post-response {
  const axios = require('axios')
  const radio = await axios.delete(
    `${bru.getEnvVar('baseUrl')}/api/sends/${bru.getVar('radioSendId')}`,
    { headers: { Cookie: bru.getVar('sessionCookie') }, validateStatus: () => true },
  )
  test('l\'envoi de selections/radio/09 est retiré aussi', () => {
    expect(radio.status).to.equal(204)
  })
}

docs {
  NOMINAL → 204 : retire l'envoi de `collections/photos/07`, puis celui de
  `selections/radio/09`. La collection ne laisse aucune ligne d'historique
  au membre.
}
